# System Configuration (auto-detect or manual override)
SYSTEM_ARCH=auto              # auto | x86_64 | arm64 | apple_silicon
SYSTEM_OS=auto                # auto | macos | windows | linux

# File Management
AUDIO_ARCHIVE_DIR=~/Downloads # Archive location for audio files
AUDIO_DEFAULT_ACTION=prompt   # prompt | delete | archive
KEEP_TRANSCRIPTS=false        # Delete transcripts after summarization

# Captions-first Configuration
# When a source ships a HUMAN-AUTHORED caption track, use it and skip both the
# audio download and the Whisper run. Machine `automatic_captions` are never
# used — they are ASR without our vocabulary hint, so Whisper is better.
CAPTIONS_FIRST=true
# Minimum real words a caption track must yield to be trusted. Music videos
# return cues that are entirely "[♪♪♪]"; below this we fall back to Whisper.
CAPTIONS_MIN_WORDS=20
# Ordered caption language preference, e.g. "en,ja" or "ja,any". The token
# "any" accepts whatever manual track the source ships — useful for a mixed
# library (e.g. Japanese instructional video on an English-configured install).
# Empty falls back to FW_LANG. CJK is counted by character, not by word.
CAPTIONS_LANG=

# faster-whisper Configuration
FW_MODEL=medium               # tiny | base | small | medium | large-v3
FW_LANG=en                    # Language code (ISO 639-1)
FW_COMPUTE=auto               # auto | int8 | float16 | int8_float16
FW_BEAM=1                     # Beam size for transcription
FW_VAD=true                   # Enable Voice Activity Detection
FW_CHUNK=30                   # Chunk length in seconds
FW_WORD_TIMESTAMPS=false      # Enable word-level timestamps

# Summarization Configuration  (does NOT affect transcription — that is local
# faster-whisper, configured above. See "Choosing a summarization backend" in
# readme.md before changing this.)
#
# LLM_MODELS is an ordered FAILOVER chain, not a quality ladder: entry 1 does
# essentially all the work; later entries fire only when an earlier one ERRORS.
# Putting a cheap model first makes it your summarizer.
#   claude-cli/<opus|sonnet|haiku>  -> logged-in Claude subscription, no API key
#   openai/… , anthropic/…          -> metered REST, needs the matching key below
#   ollama/… , lm_studio/…          -> local, no key, requires ALLOW_LOCAL_MODELS
LLM_MODELS=["claude-cli/opus", "claude-cli/sonnet", "openai/gpt-4o"]

# Local models need no API key, so without this gate a misconfigured chain could
# silently fall through to a much weaker model. Enable deliberately — e.g. for
# private/NDA content that must not leave the machine.
ALLOW_LOCAL_MODELS=false

# What to do when the subscription runs out of capacity mid-run.
#   wait    -> alert, sleep until the limit resets, retry the same video (DEFAULT)
#   metered -> continue on the paid backends in LLM_MODELS
#   local   -> continue on local backends only (needs ALLOW_LOCAL_MODELS)
#   stop    -> stop cleanly; finished videos are kept and skipped on resume
#   ask     -> prompt once, then apply that answer for the rest of the run
# "wait" is the default on purpose: an unattended run (a research agent that
# cannot answer a prompt) must never start spending money simply because nobody
# was there to say no. It waits for capacity you have already paid for.
ON_EXHAUSTION=wait
# Used only when the CLI does not report a reset time in its error output.
EXHAUSTION_WAIT_SECONDS=18000
# Upper bound, so a misparsed reset time cannot park a run for days.
EXHAUSTION_MAX_WAIT_SECONDS=43200

# Subscription CLI backend
CLAUDE_CLI_PATH=claude        # resolved on PATH if left bare
CLAUDE_CLI_TIMEOUT=900        # seconds; a long transcript is a big prompt
# `claude -p` is an AGENT, not a completion endpoint. Transcripts are untrusted
# third-party content, so tools stay disabled. Do not empty this.
CLAUDE_CLI_DISALLOWED_TOOLS=Skill,WebSearch,WebFetch,Read,Bash,Glob,Grep,Task,Agent,Edit,Write

# API Keys (metered cloud entries only — not needed for claude-cli/ or local)
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Local LLM server (used when ALLOW_LOCAL_MODELS=true)
OLLAMA_HOST=http://localhost:11434

# Deprecated: superseded by LLM_MODELS. Retained so existing .env files and
# docker-compose overrides keep loading without error.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Web UI Configuration
WEB_HOST=localhost
WEB_PORT=8000
WEB_ENABLE=true               # Enable web interface

# Cookie Configuration (yt-dlp)
YT_DLP_BROWSER=chrome         # chrome | firefox | safari